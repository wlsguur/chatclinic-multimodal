APP_ENV=development
MAX_EXAMPLE_VARIANTS=8
DEFAULT_GENOME_BUILD=GRCh37
PUBMED_EMAIL=your-email@example.com
LITERATURE_MAX_RESULTS=4
LITERATURE_TIMEOUT_SECONDS=8
ANNOTATION_TIMEOUT_SECONDS=8
EXTERNAL_HTTP_CACHE_TTL_SECONDS=86400
OPENAI_MODEL=gpt-5-mini
OPENAI_WORKFLOW_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=20
# OPENAI_API_KEY=your-key

# --- CXR tool suite (model-agnostic; default backend=fallback runs with no weights) ---
# IMPORTANT: this .env loader does NOT support inline "# comments" after a value.
# Keep notes on their own lines; leave a var empty by ending the line right after "=".
#
# Detection backend: fallback | torchvision | remote
CXR_DETECTION_BACKEND=fallback
# torchvision backend: absolute path to a detector .pth state_dict
CXR_DETECTION_WEIGHTS=
# absolute path to a labels file (.txt one-per-line, or .json list); index 0 = __background__
CXR_DETECTION_LABELS=
CXR_DETECTION_ARCH=fasterrcnn_resnet50_fpn
# device: blank = auto (cuda if available), or set to cpu
CXR_DETECTION_DEVICE=
CXR_DETECTION_SCORE_THRESHOLD=0.5
# remote backend: endpoint URL + bearer key
CXR_DETECTION_API_URL=
CXR_DETECTION_API_KEY=
#
# Segmentation backend: fallback | torchvision | remote
CXR_SEGMENTATION_BACKEND=fallback
CXR_SEGMENTATION_WEIGHTS=
CXR_SEGMENTATION_ARCH=deeplabv3_resnet50
CXR_SEGMENTATION_INPUT=512
CXR_SEGMENTATION_DEVICE=
CXR_SEGMENTATION_TARGETS=lung_left,lung_right,heart
CXR_SEGMENTATION_API_URL=
CXR_SEGMENTATION_API_KEY=
#
# Screening orchestrator stage order
CXR_SCREENING_STAGES=quality,detect,segment,measure
